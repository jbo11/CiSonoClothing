{{ 'cisono-editorial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign editorial_collection = section.settings.collection
  assign collection_count = 0
  if editorial_collection != blank
    assign collection_count = editorial_collection.products_count
  endif
-%}

<section class="cisono-editorial color-{{ section.settings.color_scheme }}">
  <div class="cisono-editorial__chrome">
    <a href="{{ routes.collections_url }}" class="cisono-editorial__link">All</a>
    <span>{{ collection_count | default: 0 }}</span>
    <a href="#cisono-story" class="cisono-editorial__link">Story</a>
    <span>01</span>
  </div>

  <div class="cisono-editorial__stage">
    <div class="cisono-editorial__meta">
      <span>{{ section.settings.kicker }}</span>
      <span>01 / 03</span>
    </div>

    <div class="cisono-editorial__hero">
      <div class="cisono-editorial__copy">
        <p class="cisono-editorial__eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
      </div>

      {%- if section.settings.image != blank -%}
        <div class="cisono-editorial__image">
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              widths: '360, 540, 720, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 44vw, 82vw',
              loading: 'eager'
          }}
        </div>
      {%- elsif editorial_collection != blank and editorial_collection.featured_image != blank -%}
        <div class="cisono-editorial__image">
          {{
            editorial_collection.featured_image
            | image_url: width: 1800
            | image_tag:
              widths: '360, 540, 720, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 44vw, 82vw',
              loading: 'eager'
          }}
        </div>
      {%- endif -%}
    </div>

    <a class="cisono-editorial__discover" href="{{ editorial_collection.url | default: routes.all_products_collection_url }}">
      <span>{{ collection_count | default: 0 }} Products</span>
      <span>Discover</span>
    </a>
  </div>

  <div class="cisono-editorial__manifesto" id="cisono-story">
    <div>
      <span>Collection</span>
      <span>02 / 03</span>
    </div>
    <p>{{ section.settings.manifesto }}</p>
  </div>

  {%- if editorial_collection != blank -%}
    <div class="cisono-editorial__products">
      <div class="cisono-editorial__meta">
        <span>Selected pieces</span>
        <span>03 / 03</span>
      </div>
      <div class="cisono-editorial__grid">
        {%- for product in editorial_collection.products limit: section.settings.products_to_show -%}
          <a href="{{ product.url }}" class="cisono-editorial__product">
            <span class="cisono-editorial__product-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if product.featured_media -%}
              {{
                product.featured_media
                | image_url: width: 800
                | image_tag:
                  widths: '240, 360, 540, 720, 800',
                  sizes: '(min-width: 990px) 22vw, 46vw',
                  loading: 'lazy'
              }}
            {%- endif -%}
            <span class="cisono-editorial__product-title">{{ product.title }}</span>
            <span class="cisono-editorial__product-price">{{ product.price | money }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "CiSono editorial landing",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Los Angeles / Everyday movement"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CiSono Clothing"
    },
    {
      "type": "textarea",
      "id": "manifesto",
      "label": "Manifesto",
      "default": "Made for the city, styled for motion. Soft layers, denim, and polished tops give women the confidence to move through the day without compromise."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "CiSono editorial landing"
    }
  ]
}
{% endschema %}
