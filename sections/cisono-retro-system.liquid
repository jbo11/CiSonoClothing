{{ 'cisono-retro-system.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cisono-retro-system.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection_one = section.settings.collection_one
  assign collection_two = section.settings.collection_two
  assign collection_three = section.settings.collection_three
  assign total_products = 0
  if collection_one != blank
    assign total_products = total_products | plus: collection_one.products_count
  endif
  if collection_two != blank
    assign total_products = total_products | plus: collection_two.products_count
  endif
  if collection_three != blank
    assign total_products = total_products | plus: collection_three.products_count
  endif
-%}

<section class="cisono-retro" data-cisono-retro>
  <div class="cisono-retro__loader" style="--retro-hero-bg: url('{{ 'cisono-la-retro-bg.png' | asset_url }}');" data-retro-loader>
    <div class="cisono-retro__loader-title" aria-hidden="true">{{ section.settings.heading }}</div>
    <div class="cisono-retro__sound-tab">[Visual mode]</div>
    <div class="cisono-retro__hud cisono-retro__hud--top">
      <span>{{ section.settings.system_label }}</span>
      <span>STATUS CHECK.................OK</span>
      <span>BIO {{ total_products | default: 0 }}:2</span>
    </div>
    <div class="cisono-retro__loader-core">
      <p>LOADING...</p>
      <p>ANALYZING LOS ANGELES ARCHIVES...</p>
      <p>RETRIEVING CISONO LOOKS...</p>
      <p>DISPLAYING "PAST IMAGES AND STORY"</p>
      <div class="cisono-retro__bar"><span data-retro-bar></span></div>
      <button class="cisono-retro__skip" type="button" data-retro-skip>Skip loading</button>
    </div>
    <div class="cisono-retro__hud cisono-retro__hud--bottom">
      <span>Calibrating fit archive...</span>
      <span>Loading Los Angeles layers...</span>
      <span>Rendering collection grid...</span>
    </div>
  </div>

  <div class="cisono-retro__frame">
    <header class="cisono-retro__topbar">
      <a href="{{ routes.all_products_collection_url }}">[View collection]</a>
      <span>{{ section.settings.system_label }}</span>
      <span>Cart {{ cart.item_count | prepend: '00' | slice: -2, 2 }}</span>
    </header>

    <div class="cisono-retro__hero" style="--retro-hero-bg: url('{{ 'cisono-la-retro-bg.png' | asset_url }}');">
      <div class="cisono-retro__sound-tab cisono-retro__sound-tab--hero">[Visual mode]</div>
      <div class="cisono-retro__hero-status">[CITY: LA]</div>
      <div class="cisono-retro__hero-panel" data-retro-reveal>
        <p>LOADING...</p>
        <p>ANALYZING LOS ANGELES ARCHIVES...</p>
        <p>RETRIEVING CISONO LOOKS...</p>
        <p>DISPLAYING "PAST IMAGES AND STORY"</p>
      </div>
      <div class="cisono-retro__hero-copy" data-retro-reveal>
        <p>[TIME: {{ 'now' | date: '%H:%M' }}]</p>
        <h1>{{ section.settings.heading }}</h1>
        <p class="cisono-retro__hero-note"><span aria-hidden="true">|||</span> Retro mood meets Los Angeles fashion energy. Everyday pieces recalibrated for confidence, movement, and repeat wear.</p>
      </div>

      <div class="cisono-retro__hero-photos" aria-label="Featured CiSono looks">
        {%- if collection_one != blank and collection_one.products.first.featured_media -%}
          <a class="cisono-retro__float-photo cisono-retro__float-photo--one" href="{{ collection_one.url }}" data-retro-float data-retro-reveal>
            <span>[001]</span>
            {{
              collection_one.products.first.featured_media
              | image_url: width: 540
              | image_tag:
                widths: '240, 360, 540',
                sizes: '(min-width: 990px) 18vw, 42vw',
                loading: 'eager'
            }}
          </a>
        {%- endif -%}
        {%- if collection_two != blank and collection_two.products.first.featured_media -%}
          <a class="cisono-retro__float-photo cisono-retro__float-photo--two" href="{{ collection_two.url }}" data-retro-float data-retro-reveal>
            <span>[002]</span>
            {{
              collection_two.products.first.featured_media
              | image_url: width: 540
              | image_tag:
                widths: '240, 360, 540',
                sizes: '(min-width: 990px) 18vw, 42vw',
                loading: 'eager'
            }}
          </a>
        {%- endif -%}
        {%- if collection_three != blank and collection_three.products.first.featured_media -%}
          <a class="cisono-retro__float-photo cisono-retro__float-photo--three" href="{{ collection_three.url }}" data-retro-float data-retro-reveal>
            <span>[003]</span>
            {{
              collection_three.products.first.featured_media
              | image_url: width: 540
              | image_tag:
                widths: '240, 360, 540',
                sizes: '(min-width: 990px) 18vw, 42vw',
                loading: 'eager'
            }}
          </a>
        {%- endif -%}
      </div>

      <div class="cisono-retro__code cisono-retro__code--hero" data-retro-reveal>
        <span>// WELCOME TO CISONO</span>
        <span>LET JOURNEYBEGIN = TRUE;</span>
        <span>OPENWARDROBE();</span>
        <span>RECALIBRATEFIT();</span>
      </div>
      <div class="cisono-retro__system-tab">SYSTEM: RUNNING</div>
    </div>

    <div class="cisono-retro__manifesto" data-retro-reveal>
      <div class="cisono-retro__story-copy">
        <span>// THE STORY</span>
        <h2>A journey through fabric, motion, and Los Angeles style.</h2>
        <p>{{ section.settings.manifesto }}</p>
      </div>
      <div class="cisono-retro__story-orbit" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <a class="cisono-retro__story-card" href="{{ routes.all_products_collection_url }}">
        <span>FEEL INTO THE FIT</span>
        <strong>CiSono rewrites everyday dressing as an LA signal.</strong>
      </a>
    </div>

    <div class="cisono-retro__marquee" aria-hidden="true">
      <span>nostalgic layers</span>
      <span>denim signal</span>
      <span>city uniform</span>
      <span>soft structure</span>
      <span>wardrobe upload</span>
    </div>

    <div class="cisono-retro__photo-archive" data-retro-reveal>
      <div class="cisono-retro__archive-title">
        <span>// INTO THE WARDROBE</span>
        <h2>Floating fits in motion</h2>
      </div>
      <div class="cisono-retro__archive-stage">
        {%- if collection_one != blank -%}
          <a class="cisono-retro__archive-copy cisono-retro__archive-copy--one" href="{{ collection_one.url }}">
            <span>[collection name] {</span>
            <h3>/ {{ collection_one.title }}</h3>
            <span>[description] {</span>
            <p>{{ collection_one.description | strip_html | default: 'Curated apparel for confident everyday movement.' | truncate: 120 }}</p>
          </a>
          {%- if collection_one.products.first.featured_media -%}
            <a class="cisono-retro__archive-photo cisono-retro__archive-photo--one" href="{{ collection_one.url }}" data-retro-float>
              <span>[001]</span>
              {{
                collection_one.products.first.featured_media
                | image_url: width: 820
                | image_tag:
                  widths: '320, 480, 640, 820',
                  sizes: '(min-width: 990px) 24vw, 78vw',
                  loading: 'lazy'
              }}
            </a>
          {%- endif -%}
        {%- endif -%}

        {%- if collection_two != blank -%}
          <a class="cisono-retro__archive-copy cisono-retro__archive-copy--two" href="{{ collection_two.url }}">
            <span>[collection name] {</span>
            <h3>/ {{ collection_two.title }}</h3>
            <span>[description] {</span>
            <p>{{ collection_two.description | strip_html | default: 'Soft structure and easy layers for the city.' | truncate: 120 }}</p>
          </a>
          {%- if collection_two.products.first.featured_media -%}
            <a class="cisono-retro__archive-photo cisono-retro__archive-photo--two" href="{{ collection_two.url }}" data-retro-float>
              <span>[002]</span>
              {{
                collection_two.products.first.featured_media
                | image_url: width: 820
                | image_tag:
                  widths: '320, 480, 640, 820',
                  sizes: '(min-width: 990px) 24vw, 78vw',
                  loading: 'lazy'
              }}
            </a>
          {%- endif -%}
        {%- endif -%}

        {%- if collection_three != blank -%}
          <a class="cisono-retro__archive-copy cisono-retro__archive-copy--three" href="{{ collection_three.url }}">
            <span>[collection name] {</span>
            <h3>/ {{ collection_three.title }}</h3>
            <span>[description] {</span>
            <p>{{ collection_three.description | strip_html | default: 'Denim signals with everyday repeat value.' | truncate: 120 }}</p>
          </a>
          {%- if collection_three.products.first.featured_media -%}
            <a class="cisono-retro__archive-photo cisono-retro__archive-photo--three" href="{{ collection_three.url }}" data-retro-float>
              <span>[003]</span>
              {{
                collection_three.products.first.featured_media
                | image_url: width: 820
                | image_tag:
                  widths: '320, 480, 640, 820',
                  sizes: '(min-width: 990px) 24vw, 78vw',
                  loading: 'lazy'
              }}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

    <div class="cisono-retro__collections">
      <div class="cisono-retro__section-label" data-retro-reveal>
        <span>// Uploading collections...</span>
        <span>[{{ total_products | default: 0 }} products detected]</span>
      </div>

      <div class="cisono-retro__cards">
        {%- if collection_one != blank -%}
          {%- render 'cisono-retro-collection-card', featured_collection: collection_one, index: 1 -%}
        {%- endif -%}
        {%- if collection_two != blank -%}
          {%- render 'cisono-retro-collection-card', featured_collection: collection_two, index: 2 -%}
        {%- endif -%}
        {%- if collection_three != blank -%}
          {%- render 'cisono-retro-collection-card', featured_collection: collection_three, index: 3 -%}
        {%- endif -%}
      </div>
    </div>

    {%- if collection_one != blank -%}
      <div class="cisono-retro__products">
        <div class="cisono-retro__section-label" data-retro-reveal>
          <span>// Selected signal</span>
          <span>{{ collection_one.title }}</span>
        </div>
        <div class="cisono-retro__product-grid">
          {%- for product in collection_one.products limit: 6 -%}
            <a href="{{ product.url }}" class="cisono-retro__product" data-retro-reveal>
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 700
                  | image_tag:
                    widths: '220, 360, 540, 700',
                    sizes: '(min-width: 990px) 16vw, 45vw',
                    loading: 'lazy'
                }}
              {%- endif -%}
              <span>{{ forloop.index | prepend: '00' | slice: -2, 2 }}</span>
              <strong>{{ product.title }}</strong>
              <em>{{ product.price | money }}</em>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <footer class="cisono-retro__closing" data-retro-reveal>
      <span>// Thanks for visiting CiSono</span>
      <h2><span>Confidence</span><span>you can wear</span><span>again.</span></h2>
      <a href="{{ routes.all_products_collection_url }}">[View collection]</a>
    </footer>
  </div>
</section>

{% schema %}
{
  "name": "CiSono Retro System",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "system_label",
      "label": "System label",
      "default": "CISONO FASHION VER. 2.6::26.006"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Retro code. Modern wardrobe."
    },
    {
      "type": "textarea",
      "id": "manifesto",
      "label": "Manifesto",
      "default": "Step into a fashion interface where soft layers, denim, and polished tops are calibrated for motion. CiSono rebuilds the everyday wardrobe with nostalgic texture, city confidence, and wear-now ease."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero fashion image"
    },
    {
      "type": "image_picker",
      "id": "support_image",
      "label": "Supporting fashion image"
    },
    {
      "type": "collection",
      "id": "collection_one",
      "label": "Collection one"
    },
    {
      "type": "collection",
      "id": "collection_two",
      "label": "Collection two"
    },
    {
      "type": "collection",
      "id": "collection_three",
      "label": "Collection three"
    }
  ],
  "presets": [
    {
      "name": "CiSono Retro System"
    }
  ]
}
{% endschema %}
